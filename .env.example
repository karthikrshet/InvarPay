# ============================================================
# PayGuard AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_ENV=development
APP_NAME=PayGuard AI
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=info
SECRET_KEY=change-me-use-a-long-random-string-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
DATABASE_URL=postgresql+asyncpg://payguard:payguard_dev@localhost:5432/payguard
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-jwt-secret-minimum-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- API Key Settings ---
API_KEY_PREFIX=pg_live_
API_KEY_TEST_PREFIX=pg_test_

# --- Razorpay (TEST MODE ONLY — never use live credentials here) ---
# Obtain from: https://dashboard.razorpay.com/app/keys (test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Set to "test" to use Razorpay test mode; "fake" to use deterministic fake provider
PAYMENT_PROVIDER=fake

# --- LLM / AI ---
# Used by investigation agent. If unset, agent returns deterministic fixture responses.
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=30

# --- Object Storage (S3-compatible) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_REPORTS=payguard-reports
S3_REGION=us-east-1

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=payguard-api

# --- Feature Flags ---
# Phase 2+: set to "true" to enable
FEATURE_PAYMENTGRAPH=false
FEATURE_PAYDEV=false
FEATURE_MERCHANTOS=false
FEATURE_SHOPAGENT=false
FEATURE_MCP=false

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- Webhook ---
WEBHOOK_REPLAY_WINDOW_SECONDS=300
WEBHOOK_MAX_PAYLOAD_BYTES=1048576

# --- Demo / Seed ---
SEED_DEMO_DATA=true
DEMO_ORG_NAME=Demo Merchant Inc.
